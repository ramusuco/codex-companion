{
  "name": "codex-companion",
  "displayName": "codex-companion",
  "description": "Codex の保存済み会話を固定タブで開く、小さな補助拡張。",
  "version": "0.4.0",
  "publisher": "rmsc",
  "engines": {
    "vscode": "^1.96.2"
  },
  "categories": [
    "Other"
  ],
  "main": "./src/extension.js",
  "extensionDependencies": [
    "openai.chatgpt"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node --check src/extension.js && node --check src/backend.js && node --check src/sessions.js && node --check src/telemetry.js",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "npm run check && npm test"
  },
  "contributes": {
    "commands": [
      {
        "command": "codexCompanion.new",
        "title": "新規タブを開く（試作）",
        "category": "codex-companion",
        "icon": "$(add)"
      },
      {
        "command": "codexCompanion.search",
        "title": "会話を検索してタブで開く",
        "category": "codex-companion",
        "icon": "$(search)"
      },
      {
        "command": "codexCompanion.refresh",
        "title": "会話一覧を更新",
        "category": "codex-companion",
        "icon": "$(refresh)"
      },
      {
        "command": "codexCompanion.open",
        "title": "会話をタブで開く",
        "category": "codex-companion"
      },
      {
        "command": "codexCompanion.openBeside",
        "title": "会話を右側に開く",
        "category": "codex-companion",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "codexCompanion.restore",
        "title": "前回開いていた会話タブを復元",
        "category": "codex-companion",
        "icon": "$(history)"
      },
      {
        "command": "codexCompanion.rename",
        "title": "名前を変更",
        "category": "codex-companion",
        "icon": "$(edit)"
      },
      {
        "command": "codexCompanion.archive",
        "title": "会話をアーカイブ",
        "category": "codex-companion",
        "icon": "$(archive)"
      },
      {
        "command": "codexCompanion.unarchive",
        "title": "アーカイブした会話を戻す",
        "category": "codex-companion",
        "icon": "$(discard)"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "codexCompanion.sessions",
          "name": "codex-companion"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "codexCompanion.sessions",
        "contents": "保存済みの会話がまだありません。\n[新規タブを開く](command:codexCompanion.new)\n[一覧を更新](command:codexCompanion.refresh)\n別の環境の会話は設定の Codex Home を確認してください。"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "codexCompanion.new",
          "when": "view == codexCompanion.sessions",
          "group": "navigation@1"
        },
        {
          "command": "codexCompanion.search",
          "when": "view == codexCompanion.sessions",
          "group": "navigation@2"
        },
        {
          "command": "codexCompanion.refresh",
          "when": "view == codexCompanion.sessions",
          "group": "navigation@3"
        },
        {
          "command": "codexCompanion.restore",
          "when": "view == codexCompanion.sessions",
          "group": "actions"
        },
        {
          "command": "codexCompanion.unarchive",
          "when": "view == codexCompanion.sessions",
          "group": "actions"
        }
      ],
      "view/item/context": [
        {
          "command": "codexCompanion.openBeside",
          "when": "view == codexCompanion.sessions && viewItem == codexSession",
          "group": "inline"
        },
        {
          "command": "codexCompanion.rename",
          "when": "view == codexCompanion.sessions && viewItem == codexSession",
          "group": "inline"
        },
        {
          "command": "codexCompanion.archive",
          "when": "view == codexCompanion.sessions && viewItem == codexSession",
          "group": "inline"
        }
      ],
      "editor/title": [
        {
          "command": "codexCompanion.new",
          "when": "resourceScheme == openai-codex",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "codexCompanion.open",
          "when": "false"
        },
        {
          "command": "codexCompanion.openBeside",
          "when": "false"
        },
        {
          "command": "codexCompanion.rename",
          "when": "false"
        },
        {
          "command": "codexCompanion.archive",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "codex-companion",
      "properties": {
        "codexCompanion.codexHome": {
          "type": "string",
          "default": "",
          "description": "会話一覧を読む Codex ディレクトリ。空なら CODEX_HOME または ~/.codex。"
        },
        "codexCompanion.maxSessions": {
          "type": "number",
          "default": 200,
          "minimum": 1,
          "maximum": 5000,
          "description": "一覧に表示する最近の会話数。"
        }
      }
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ramusuco/codex-companion.git"
  },
  "homepage": "https://github.com/ramusuco/codex-companion#readme",
  "bugs": {
    "url": "https://github.com/ramusuco/codex-companion/issues"
  },
  "keywords": [
    "codex",
    "chat",
    "sessions",
    "tabs",
    "rename",
    "archive"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "files": [
    "src/**",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@vscode/vsce": "4.0.0"
  }
}

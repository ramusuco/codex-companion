{
  "name": "codex-companion",
  "displayName": "codex-companion",
  "description": "A companion for Codex: conversation tabs, renaming, archiving, and account usage.",
  "version": "0.7.0",
  "publisher": "rmsc",
  "engines": {
    "vscode": "^1.96.2"
  },
  "categories": [
    "Other"
  ],
  "main": "./src/extension.js",
  "extensionDependencies": [
    "openai.chatgpt"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node --check src/extension.js && node --check src/backend.js && node --check src/sessions.js && node --check src/telemetry.js && node --check src/limits.js && node --check src/usage-view.js && node --check src/panel-client.js",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "npm run check && npm test"
  },
  "contributes": {
    "commands": [
      {
        "command": "codexCompanion.refreshLimits",
        "title": "Refresh Account Usage",
        "category": "codex-companion",
        "icon": "$(refresh)"
      },
      {
        "command": "codexCompanion.new",
        "title": "New Conversation Tab (Experimental)",
        "category": "codex-companion",
        "icon": "$(add)"
      },
      {
        "command": "codexCompanion.search",
        "title": "Search Conversations",
        "category": "codex-companion",
        "icon": "$(search)"
      },
      {
        "command": "codexCompanion.refresh",
        "title": "Refresh Conversations",
        "category": "codex-companion",
        "icon": "$(refresh)"
      },
      {
        "command": "codexCompanion.open",
        "title": "Open Conversation",
        "category": "codex-companion"
      },
      {
        "command": "codexCompanion.openBeside",
        "title": "Open to the Side",
        "category": "codex-companion",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "codexCompanion.restore",
        "title": "Restore Previous Tabs",
        "category": "codex-companion",
        "icon": "$(history)"
      },
      {
        "command": "codexCompanion.rename",
        "title": "Rename Conversation",
        "category": "codex-companion",
        "icon": "$(edit)"
      },
      {
        "command": "codexCompanion.archive",
        "title": "Archive Conversation",
        "category": "codex-companion",
        "icon": "$(archive)"
      },
      {
        "command": "codexCompanion.unarchive",
        "title": "Restore Archived Conversation",
        "category": "codex-companion",
        "icon": "$(discard)"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "codexCompanion.sessions",
          "name": "codex-companion",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "codexCompanion.new",
          "when": "view == codexCompanion.sessions",
          "group": "navigation@1"
        },
        {
          "command": "codexCompanion.search",
          "when": "view == codexCompanion.sessions",
          "group": "navigation@2"
        },
        {
          "command": "codexCompanion.refresh",
          "when": "view == codexCompanion.sessions",
          "group": "navigation@3"
        },
        {
          "command": "codexCompanion.restore",
          "when": "view == codexCompanion.sessions",
          "group": "actions"
        },
        {
          "command": "codexCompanion.unarchive",
          "when": "view == codexCompanion.sessions",
          "group": "actions"
        }
      ],
      "editor/title": [
        {
          "command": "codexCompanion.new",
          "when": "resourceScheme == openai-codex",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "codexCompanion.open",
          "when": "false"
        },
        {
          "command": "codexCompanion.openBeside",
          "when": "false"
        },
        {
          "command": "codexCompanion.rename",
          "when": "false"
        },
        {
          "command": "codexCompanion.archive",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "codex-companion",
      "properties": {
        "codexCompanion.codexHome": {
          "type": "string",
          "default": "",
          "description": "Codex data directory. Defaults to CODEX_HOME or ~/.codex."
        },
        "codexCompanion.maxSessions": {
          "type": "number",
          "default": 200,
          "minimum": 1,
          "maximum": 5000,
          "description": "Maximum number of recent conversations to display."
        }
      }
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ramusuco/codex-companion.git"
  },
  "homepage": "https://github.com/ramusuco/codex-companion#readme",
  "bugs": {
    "url": "https://github.com/ramusuco/codex-companion/issues"
  },
  "keywords": [
    "codex",
    "chat",
    "sessions",
    "tabs",
    "rename",
    "archive"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "files": [
    "src/**",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@vscode/vsce": "4.0.0"
  }
}
